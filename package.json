{
  "name": "@dropzone/monorepo",
  "private": true,
  "description": "Monorepo for the Dropzone library, its documentation and its website.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropzone/dropzone.git"
  },
  "scripts": {
    "build": "pnpm --recursive --filter=./packages/* --filter=./apps/* run build",
    "build:lib": "pnpm --filter dropzone run build",
    "build:site": "pnpm --filter @dropzone/website run build",
    "build:docs": "pnpm --filter @dropzone/docs run build",
    "dev:site": "pnpm --filter @dropzone/website run dev",
    "dev:docs": "pnpm --filter @dropzone/docs run start",
    "test": "pnpm --filter dropzone run test",
    "test:watch": "pnpm --filter dropzone run test:watch",
    "test:e2e": "pnpm --filter dropzone run test:e2e",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.24.0"
}
