{
  "name": "dropzone",
  "version": "6.0.0-beta.2",
  "description": "Handles drag and drop of files for you.",
  "keywords": [
    "dragndrop",
    "drag and drop",
    "file upload",
    "upload"
  ],
  "homepage": "https://www.dropzone.dev/js",
  "main": "dist/dropzone.js",
  "module": "dist/dropzone.mjs",
  "standalone": "dist/dropzone-min.js",
  "files": [
    "dist",
    "src",
    "composer.json",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md"
  ],
  "maintainers": [
    {
      "name": "Matias Meno",
      "email": "m@tias.me",
      "web": "https://www.yesmeno.com"
    }
  ],
  "contributors": [
    {
      "name": "Matias Meno",
      "email": "m@tias.me",
      "web": "https://www.yesmeno.com"
    }
  ],
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && vite build --config vite.config.global.mjs && pnpm run css",
    "css": "sass src/:dist/ --style compressed",
    "watch-css": "sass src/:dist/ --watch --style compressed",
    "test": "vitest run",
    "start-test-server": "node test/test-server.js",
    "test:watch": "vitest"
  },
  "bugs": {
    "email": "m@tias.me",
    "url": "https://github.com/dropzone/dropzone/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.7.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/dropzone/dropzone.git"
  },
  "dependencies": {
    "just-extend": "^5.0.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.11",
    "cypress": "^8.7.0",
    "cypress-file-upload": "^5.0.8",
    "node-static": "^0.7.11",
    "playwright": "^1.62.1",
    "sass": "^1.33.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
