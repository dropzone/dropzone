{
  "name": "dropzone",
  "version": "6.2.0",
  "description": "Handles drag and drop of files for you.",
  "keywords": [
    "drag and drop",
    "dragndrop",
    "file upload",
    "upload"
  ],
  "homepage": "https://www.dropzone.dev/js",
  "bugs": {
    "url": "https://github.com/dropzone/dropzone/issues",
    "email": "m@tias.me"
  },
  "license": "MIT",
  "maintainers": [
    {
      "name": "Matias Simon",
      "email": "m@tias.me",
      "web": "https://www.matsimon.dev"
    }
  ],
  "contributors": [
    {
      "name": "Matias Simon",
      "email": "m@tias.me",
      "web": "https://www.matsimon.dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropzone/dropzone.git"
  },
  "files": [
    "dist",
    "src",
    "composer.json",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md"
  ],
  "main": "dist/dropzone.js",
  "module": "dist/dropzone.mjs",
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build && vite build --config vite.config.global.mjs && pnpm run css",
    "css": "sass src/:dist/ --style compressed",
    "watch-css": "sass src/:dist/ --watch --style compressed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/browser-playwright": "^4.1.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "sass": "^1.33.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.24.0",
  "standalone": "dist/dropzone-min.js"
}
